---
import '@fontsource-variable/source-sans-3';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/rajdhani/600.css';
import '@fontsource/rajdhani/700.css';
import '../styles/night.css';
import '../styles/hud.css';
import '../styles/cine.css';
import { profile, education, jobs, projects, WINDOWS } from '../content';
// Terminal session styles (terminal-ui: overlay chrome; terminal: the look; interact: dock-mode states).
import.meta.glob('../styles/carriers/*.css', { eager: true });

const sections = [
  { id: 'city', name: 'City', label: '', start: 0 }, { id: 'education', name: 'Campus', label: 'Education', start: 0.1 },
  { id: 'work', name: 'Downtown', label: 'Work', start: 0.22 }, { id: 'projects', name: 'Market', label: 'Projects', start: 0.68 },
  { id: 'contact', name: 'Harbor', label: 'Contact', start: 0.92 },
];
const win = (k: string) => WINDOWS[k].join(',');
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Ivan He · GPU Software Performance Engineer</title>
    <meta name="description" content={`${profile.name} is a GPU software performance engineer in the ${profile.location}.`} />
    <meta property="og:title" content="Ivan He · GPU Software Performance Engineer" />
    <meta property="og:description" content={profile.summary} />
    <meta property="og:image" content="/og.jpg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-ronin-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-ronin.png" />
  </head>
  <body>
    <a class="skip" href="#education">Skip to content</a>
    <!-- The lightweight car renders on the gate; Enter starts building the city. -->
    <div id="gate" class="gate" role="dialog" aria-modal="true" aria-labelledby="gate-h" aria-describedby="gate-notice">
      <div class="gate-bg" aria-hidden="true"></div>
      <div class="gate-car" aria-hidden="true"></div>
      <header class="gate-top">
        <p class="gate-kicker">Interactive résumé</p>
        <h2 id="gate-h" class="gate-name">{profile.name}</h2>
        <p class="gate-role">{profile.title}</p>
      </header>
      <div class="gate-bottom">
        <button class="neon-btn primary gate-enter" type="button" data-choice="full">Enter the city</button>
        <p id="gate-notice" class="gate-notice">
          <span class="gate-warn"><span aria-hidden="true">⚠&#xFE0E;</span> Flashing lights<span class="visually-hidden"> and fast motion. If you are sensitive to flashing images, turn on reduced motion.</span></span>
          <label class="gate-reduce"><input id="gate-reduce" type="checkbox" role="switch" /><span class="gate-switch" aria-hidden="true"></span> Reduce motion</label>
        </p>
        <nav class="gate-links" aria-label="Profile links">
          <a href="/resume">Résumé</a>
          <span class="gate-icons">
            <a href={profile.links.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn (opens in a new tab)"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M4.98 3.5A2.5 2.5 0 1 1 5 8.5a2.5 2.5 0 0 1-.02-5ZM3 9.75h4v11H3v-11Zm6.5 0h3.8v1.5h.06c.53-1 1.83-1.75 3.34-1.75 3.57 0 4.3 2.2 4.3 5.3v5.95h-4v-5.3c0-1.26-.02-2.9-1.77-2.9-1.77 0-2.04 1.38-2.04 2.8v5.4h-3.7v-11Z"/></svg></a>
            <a href={profile.links.github} target="_blank" rel="noopener" aria-label="GitHub (opens in a new tab)"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M12 .8a11.2 11.2 0 0 0-3.54 21.83c.56.1.76-.24.76-.54v-1.9c-3.12.68-3.78-1.5-3.78-1.5-.51-1.3-1.25-1.64-1.25-1.64-1.02-.7.08-.68.08-.68 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.63 1.22 3.27.93.1-.73.4-1.22.72-1.5-2.5-.28-5.12-1.24-5.12-5.54 0-1.22.44-2.22 1.15-3-.11-.29-.5-1.43.11-2.97 0 0 .94-.3 3.08 1.14a10.6 10.6 0 0 1 5.6 0c2.14-1.45 3.08-1.14 3.08-1.14.61 1.54.23 2.68.11 2.97.72.78 1.15 1.78 1.15 3 0 4.31-2.63 5.26-5.13 5.53.4.35.76 1.03.76 2.08v3.09c0 .3.2.65.77.54A11.2 11.2 0 0 0 12 .8Z"/></svg></a>
          </span>
        </nav>
      </div>
    </div>
    <!-- The gate's live car canvas moves into this overlay while the city builds. -->
    <div id="boot" class="boot" aria-busy="true">
      <div class="boot-media" aria-hidden="true">
      </div>
      <div class="boot-top">
        <p class="boot-wordmark" data-text="IVAN HE">IVAN HE</p>
        <p class="boot-kicker">Neon Harbor · inbound</p>
      </div>
      <div class="boot-hud">
        <div class="boot-bar" aria-hidden="true"><i></i></div>
        <div class="boot-row">
          <p class="boot-pct" aria-hidden="true">00%</p>
          <ol class="boot-log" aria-hidden="true"><li class="is-live">downloading the city</li></ol>
        </div>
        <p class="boot-msg"></p>
      </div>
      <p class="boot-sr visually-hidden" role="status" aria-live="polite"></p>
    </div>
    <script is:inline>
      // Gate + landing mode, before first paint. Off (?flat, ?nolanding, ?p=, no WebGL): no gate, the plain boot screen.
      // Otherwise the gate opens with the remembered choice (localStorage nh-gate) or the OS reduced-motion preference
      // pre-selected, and catches a click that lands before gate.ts has loaded.
      (function () {
        var gate = document.getElementById('gate'), boot = document.getElementById('boot'), q = new URLSearchParams(location.search);
        if (q.has('flat') || q.has('nolanding') || q.has('p') || !('WebGLRenderingContext' in window)) { boot.dataset.landing = 'off'; gate.remove(); return; }
        boot.dataset.landing = 'pending';
        var saved = null;
        try { saved = localStorage.getItem('nh-gate'); } catch (e) {}
        if (saved !== 'full' && saved !== 'reduced') saved = null;
        var pre = saved || (matchMedia('(prefers-reduced-motion: reduce)').matches ? 'reduced' : 'full');
        gate.dataset.pre = pre;
        gate.dataset.state = 'open';
        if (saved) gate.classList.add('is-returning');
        // One Enter button; the Reduce motion switch decides the choice (mirrored on the button's data-choice).
        var enter = gate.querySelector('.gate-enter'), sw = document.getElementById('gate-reduce');
        var sync = function () { enter.setAttribute('data-choice', sw.checked ? 'reduced' : 'full'); };
        sw.checked = pre === 'reduced'; sync();
        sw.addEventListener('change', sync);
        enter.focus({ preventScroll: true });
        gate.addEventListener('click', function (e) {
          var b = e.target.closest && e.target.closest('.gate-enter');
          if (!b || window.__gateModule || window.__gateChoice) return; // gate.ts handles it once loaded
          var c = b.getAttribute('data-choice');
          window.__gateChoice = c;
          try { localStorage.setItem('nh-gate', c); } catch (e) {}
          if (c === 'reduced') document.documentElement.classList.add('reduce-motion');
          gate.dataset.state = 'closed';
          boot.dataset.landing = 'poster';
        });
      })();
    </script>
    <script is:inline>
      // Runs before the app bundle arrives: creep the boot bar toward 12% so the download phase isn't a frozen screen
      // (from Enter when the gate is up; boot.ts takes the bar over once it loads).
      (function () {
        var boot = document.getElementById('boot'), bar = document.querySelector('.boot-bar i'), pct = document.querySelector('.boot-pct'), t0 = Date.now();
        function tick() {
          if (!bar || document.documentElement.classList.contains('is-booted') || bar.dataset.owned) return;
          if (boot.dataset.landing === 'pending') { t0 = Date.now(); return requestAnimationFrame(tick); }
          var s = Date.now() - t0, v = 12 * (1 - Math.exp(-s / 5000));
          bar.style.width = v.toFixed(1) + '%'; pct.textContent = String(Math.round(v)).padStart(2, '0') + '%';
          requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
      })();
    </script>
    <nav class="nav" aria-label="Primary">
      {sections.map((s) => <a href={`#${s.id}`} data-section={s.id} aria-label={s.label ? `${s.name} — ${s.label}` : s.name}>{s.name}{s.label && <small>{s.label}</small>}</a>)}
      <button class="audio-toggle" type="button" aria-pressed="false" aria-label="Unmute ambient sound"><span class="on">♪</span><span class="off">♪̸</span></button>
    </nav>

    <div id="stage" class="stage" aria-hidden="true"></div>

    <!-- No scrolling: the nav pans the camera (scene/night/nav.ts). The ids below only serve the flat page's anchors. -->
    <main class="journey" id="city">
      <div class="ui-src">
        <article id="hero-copy" class="hero-copy">
          <h1>{profile.name}</h1>
          <p class="role">{profile.title}</p>
          <div class="actions">
            <a class="neon-btn primary" href="#education" data-section="education">Enter the city</a>
            <a class="neon-btn outline" href="/resume">Résumé</a>
          </div>
          <button class="hero-tilt" type="button" hidden>Tilt to look around ◈</button>
        </article>

        <section class="slab" id="education" data-slab="education" data-window={win('education')} aria-labelledby="edu-h">
          <header>
            <span class="kicker">Education</span>
            <h2 id="edu-h">{education.school}</h2>
            <p class="meta"><span>{education.degree}</span><span>{education.dates}</span></p>
          </header>
          <div class="cols">
            <div>
              <h3>Certifications</h3>
              <ul class="bullets">{education.certifications.map((c) => <li data-detail={education.details[c]}>{c}</li>)}</ul>
            </div>
            <div>
              <h3>Toolbox</h3>
              <ul class="chips">{education.skills.map((s) => <li data-detail={education.details[s]}>{s}</li>)}</ul>
            </div>
          </div>
        </section>

        {jobs.map((j, i) => (
          <section class="slab job" id={i === 0 ? 'work' : undefined} data-slab={j.id} data-window={win(j.id)} aria-labelledby={`job-${j.id}`}>
            <header>
              <span class="kicker">{j.label}</span>
              <h2 id={`job-${j.id}`}>{j.role}</h2>
              <p class="meta"><span>{j.org}</span><span>{j.dates}</span><span>{j.location}</span></p>
              {j.team && <p class="team">{j.team}</p>}
            </header>
            {j.pages ? (
              <!-- Pages (bus-stop dock: tabs 2017 / 2018, ←/→ flip; the flat page stacks them). -->
              <div class="pages">
                {j.pages.map((pg, k) => (
                  <div class={k === 0 ? 'page is-cur' : 'page'} data-page={k}>
                    <h3>{pg.title}</h3>
                    <ul class="bullets">{pg.bullets.map((b) => <li>{b}</li>)}</ul>
                  </div>
                ))}
                <ol class="page-dots" aria-hidden="true">{j.pages.map((_, k) => <li class={k === 0 ? 'is-cur' : undefined} data-dot={k}></li>)}</ol>
              </div>
            ) : j.bullets.length > 0 && <ul class="bullets">{j.bullets.map((b) => <li>{b}</li>)}</ul>}
            {j.id === 'kioxia' && (
              <!-- LED-wall channels (megascreen dock: tabs JOB / AD / SYSTEM, ←/→). JOB is the section above; these stay hidden unless data-ch selects them. -->
              <div class="ch ch-ad" data-ch="2" aria-hidden="true">
                <span class="ad-brand">NEO-CHROMA</span>
                <span class="ad-line">DRINK THE GLOW · NOW AT PIER 9</span>
              </div>
              <div class="ch ch-sys" data-ch="3" aria-hidden="true">
                <span class="sys-title">SYSTEM · LIVE</span>
                <dl class="sys">
                  <div><dt>Frames / s</dt><dd data-sys="fps">—</dd></div>
                  <div><dt>Draw calls</dt><dd data-sys="draws">—</dd></div>
                  <div><dt>Triangles</dt><dd data-sys="tris">—</dd></div>
                  <div><dt>Pixel ratio</dt><dd data-sys="dpr">—</dd></div>
                </dl>
                <p class="sys-note">The wall profiles itself — GPU performance engineering, live.</p>
              </div>
            )}
          </section>
        ))}

        <section class="stack" id="projects" data-slab="projects" data-window={win('projects')} aria-label="Projects">
          <h2 class="visually-hidden">Projects</h2>
          {projects.map((p, i) => (
            <article class="card" data-card={p.id} data-index={i} tabindex="0">
              <!-- The screenshot: the terminal session's framebuffer in the detail view (scanlines on .shot::after). -->
              <div class="shot"><img src={p.shot} alt={`${p.name} screenshot`} width="1280" height="800" loading="eager" decoding="async" /></div>
              <div class="card-body">
                <h3>{p.name}{p.status && <small>{p.status}</small>}</h3>
                <p class="tagline">{p.tagline}</p>
                <p class="desc">{p.description}</p>
                <ul class="chips">{p.stack.map((s) => <li>{s}</li>)}</ul>
                <p class="links">
                  {p.github && <a href={p.github} target="_blank" rel="noopener">Open repo ↗</a>}
                  {p.live && <a href={p.live} target="_blank" rel="noopener">Open live ↗</a>}
                  {!p.github && !p.live && <span class="muted">Private — showcase only</span>}
                </p>
              </div>
            </article>
          ))}
        </section>

        <section class="slab contact-slab" id="contact" data-slab="contact" data-window={win('contact')} aria-labelledby="contact-h">
          <header>
            <span class="kicker">Contact</span>
            <h2 id="contact-h">Let’s talk shop.</h2>
            <p class="meta"><span>{profile.location}</span></p>
          </header>
          <p class="lede">{profile.summary}</p>
          <div class="actions">
            <a class="neon-btn primary" href={profile.links.linkedin} target="_blank" rel="noopener" data-status="Boarding">LinkedIn</a>
            <a class="neon-btn outline" href={profile.links.github} target="_blank" rel="noopener" data-status="Boarding">GitHub</a>
            <a class="neon-btn outline" href="/resume" data-status="PDF">Résumé</a>
          </div>
        </section>
      </div>
    </main>

    <!-- Terminal session (scene/night/session.ts, styles/carriers/terminal-ui.css): the docked section's element moves into
         .term-body. Keeps the `sheet` class: hud.ts measures it to park the phone chip bar on its top edge. -->
    <aside class="sheet term" hidden aria-live="polite" aria-label="Terminal session">
      <header class="term-head" aria-hidden="true"><span class="term-node">NEON HARBOR // TERMINAL</span><span class="term-tty">TTY01</span></header>
      <div class="term-body"></div>
      <footer class="term-foot" aria-hidden="true"><span class="term-hint"></span><span class="term-status">Ready<i class="term-cursor">▮</i></span></footer>
    </aside>

    <!-- Walk-mode HUD (scene/night/hud.ts, styles/hud.css). data-mode: ride | walk | dock. -->
    <div id="hud" class="hud" data-mode="ride">
      <!-- Transition cutscene (scene/night/nav.ts beats → hud.cutscene): letterbox bars, the skip chip, the reduced-motion fade. -->
      <div class="hud-bars" aria-hidden="true"><i class="hud-bar top"></i><i class="hud-bar bottom"></i></div>
      <button class="hud-skip" type="button" aria-label="Skip scene transition">Skip <span aria-hidden="true">▸</span></button>
      <div class="hud-fade" aria-hidden="true"></div>
      <div class="hud-toast" hidden aria-live="polite"><span class="hud-toast-name"></span><small class="hud-toast-sub"></small></div>
      <button class="hud-prompt" type="button" hidden aria-live="polite"><kbd>E</kbd><span class="hud-prompt-label"></span></button>
      <div class="hud-hint" hidden>
        <p class="hud-hint-title">Controls</p>
        <ul>
          <li class="keys-only"><kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd><span>move</span></li>
          <li class="keys-only"><kbd>Shift</kbd><span>run</span></li>
          <li class="keys-only"><kbd>E</kbd><span>interact</span></li>
          <li class="keys-only"><kbd>Q</kbd><kbd>E</kbd><span>turn camera</span></li>
          <li class="keys-only"><kbd>Esc</kbd><span>back</span></li>
          <li class="keys-only">drag<span>look around</span></li>
          <li class="touch-only">left thumb<span>move</span></li>
          <li class="touch-only">push past the ring<span>run</span></li>
          <li class="touch-only">right thumb<span>look around</span></li>
          <li class="touch-only"><kbd>E</kbd><span>interact</span></li>
        </ul>
      </div>
      <button class="hud-back" type="button" hidden>← Back</button>
      <div class="hud-touch" aria-hidden="true">
        <div class="stick-zone">
          <div class="stick"><i class="stick-knob"></i></div>
          <div class="stick-rest"><span>move</span></div>
        </div>
        <div class="hud-btns"><span class="hud-elabel"></span><button class="hud-btn hud-btn-e" data-act="interact" type="button" tabindex="-1">E</button></div>
      </div>
      <!-- Phone chip bar (dock mode, coarse pointers): the docked carrier's named actions; hud.ts shows only the ones it defines. -->
      <div class="hud-chips" hidden aria-hidden="true">
        <button class="hud-chip" data-chip="up" type="button" tabindex="-1">▲</button>
        <button class="hud-chip" data-chip="down" type="button" tabindex="-1">▼</button>
        <button class="hud-chip" data-chip="left" type="button" tabindex="-1">◀</button>
        <button class="hud-chip" data-chip="right" type="button" tabindex="-1">▶</button>
        <button class="hud-chip hud-chip-ok" data-chip="confirm" type="button" tabindex="-1">✓</button>
      </div>
    </div>

    <footer class="contact">
      <a href={profile.links.linkedin}>LinkedIn</a>
      <a href={profile.links.github}>GitHub</a>
      <a href="/resume">Résumé</a>
    </footer>

    <script>
      import '../scene/night/resume-overlay';
      import { start } from '../scene/night/main';
      import { boot } from '../scene/night/boot';
      import { gate } from '../scene/night/gate';
      const stage = document.getElementById('stage')!;
      const flat = new URLSearchParams(location.search).has('flat') || !('WebGLRenderingContext' in window);
      const run = () => {
        boot.begin();
        start(stage)
          .then((info) => console.info('[night]', info))
          .catch((err) => {
            console.error('[night] falling back to static page', err);
            boot.fail(String(err?.message ?? err).slice(0, 80));
            document.documentElement.classList.add('no-3d');
          });
      };
      if (flat) { document.documentElement.classList.add('no-3d'); boot.hide(); }
      else if (gate.enabled) gate.wait().then(run); // nothing 3D until the visitor enters
      else run();
    </script>
  </body>
</html>
